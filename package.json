{
  "name": "dsh-tokbook",
  "description": "Cross-session token-usage ledger for DeepSeek Harness (DSH). Host half folds provider usage into a durable book; browser half shows it via a sidebar footer button + shell overlay.",
  "version": "0.1.1",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "token-usage",
    "usage-ledger",
    "cost-tracking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "ledger": "node --experimental-strip-types scripts/preview-overlay.ts --ledger",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "selfcheck": "node --experimental-strip-types scripts/selfcheck-rebuild.ts",
    "selfcheck:ui": "node --experimental-strip-types scripts/selfcheck-ui.ts",
    "test": "pnpm smoke && pnpm selfcheck && pnpm selfcheck:ui",
    "prepublishOnly": "pnpm build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a285292107s/dsh-tokbook.git"
  },
  "homepage": "https://github.com/a285292107s/dsh-tokbook#readme",
  "bugs": {
    "url": "https://github.com/a285292107s/dsh-tokbook/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0"
  }
}
